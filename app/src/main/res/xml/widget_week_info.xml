<?xml version="1.0" encoding="utf-8"?>
<!--
  「本周班次」小组件的元数据：一行高（targetCellHeight=1），宽度按 4 列。

  高度只给一行的位置，所以 minHeight 取 40dp —— 再矮日期和班次名就叠在一起了；
  横向可拉伸（列宽按 widget 宽度算），纵向不给 resize：这是个"一行"的组件。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_week_label"
    android:initialLayout="@layout/widget_week_view"
    android:minHeight="40dp"
    android:minWidth="250dp"
    android:previewImage="@drawable/widget_week_preview"
    android:resizeMode="horizontal"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
