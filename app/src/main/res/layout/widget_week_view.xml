<?xml version="1.0" encoding="utf-8"?>
<!--
  「本周班次」小组件：头部（月份 + 星期表头，**固定不翻页**）+ 一行 7 天（↑↓ 翻页换周）。

  翻页为什么不用滚动：RemoteViews 收不到自定义手势，能滑的只有 ListView 那类集合控件，
  而 ListView 没有吸附（滑完停在两行之间）。ViewFlipper 一页就是一整行，翻页由头部右侧的 ↑↓ 驱动；
  它的子视图是一次性 addView 的，setDisplayedChild 立刻生效，缩放后尺寸也会跟着重算。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/week_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="5dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/week_widget_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/week_widget_page_up"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/widget_page_up"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_arrow_up" />

        <ImageView
            android:id="@+id/week_widget_page_down"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/widget_page_down"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_arrow_down" />
    </LinearLayout>

    <!-- 星期表头：不随日期行翻页，列宽由 Provider 显式设置（与日期格同一个值） -->
    <LinearLayout
        android:id="@+id/week_widget_weekdays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:baselineAligned="false"
        android:orientation="horizontal" />

    <!-- 一周一页，↑↓ 翻页 -->
    <ViewFlipper
        android:id="@+id/week_widget_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="1dp"
        android:layout_weight="1" />
</LinearLayout>
