<?xml version="1.0" encoding="utf-8"?>
<!--
  翻月箭头。**必须自带 tint**：path 的白色是给 tint 当遮罩用的，
  漏了 tint 就是白箭头画在白卡片上一片空白（踩过——按钮能点、能翻月，但用户看不见它）。
  不要改成在 RemoteViews 里 setColorFilter：那要求目标必须是 ImageView，写错在宿主 apply() 时才炸。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/widget_text_secondary">
    <path
        android:fillColor="@android:color/white"
        android:pathData="M8.59,16.59L10,18l6,-6 -6,-6 -1.41,1.41L13.17,12z" />
</vector>
