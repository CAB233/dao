<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 扫码导入排班方案 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dao">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Dao.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          扫码页：zxing 自带的 CaptureActivity 被库声明成 sensorLandscape，
          这里换成自己的 Activity（Compose 顶栏 + CaptureManager），
          不写 screenOrientation，由运行时锁定为进入时的方向。
        -->
        <activity
            android:name=".ui.scan.ScanCaptureActivity"
            android:exported="false"
            android:theme="@style/Theme.Dao" />

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <!--
          「今日班次」桌面小组件。
          updatePeriodMillis = 0（见 widget_today_info.xml），刷新由 Provider 自己排的闹钟驱动。
          这里必须 exported：DATE_CHANGED / TIME_SET / TIMEZONE_CHANGED / BOOT_COMPLETED 只由系统发出，
          non-exported 的清单接收器收不到；Provider 对这些 action 只做一次重算，不接收任何参数。
        -->
        <receiver
            android:name=".widget.DaoWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_month_info" />
        </receiver>

        <!--
          「本周班次」小组件：头部固定，一行（一周 7 天）靠 ↑↓ 翻页换周。
          与上面那个是两个独立的 receiver —— 同一个类写两个同级 <receiver> 会在合并时报错。
        -->
        <receiver
            android:name=".widget.DaoWeekWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_info" />
        </receiver>

    </application>

</manifest>
