<?xml version="1.0" encoding="utf-8"?>
<!--
  上月/下月补位日：比 day_empty 更浅一档。色值走 @color/widget_day_outside（values-night 有深色版）——
  之前这里写死 #FFF8F8F8，深色模式下补位格还是白的（真机反馈过）。
  这样补位格与「本月但没排班」的浅灰格能一眼区分开，日历又保持连续、列对齐表头。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_day_outside" />
    <corners android:radius="8dp" />
</shape>