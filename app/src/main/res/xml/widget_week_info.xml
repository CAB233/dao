<?xml version="1.0" encoding="utf-8"?>
<!--
  「本周班次」小组件的元数据：一行高（targetCellHeight=1），宽度按 4 列。

  高度默认一格（targetCellHeight=1），但**允许纵向拉伸到两格** —— 拉高之后 DaoWeekWidgetProvider 会
  从 OPTION_APPWIDGET_SIZES 读到更大的高度并把日期字号调大（字号是分档的，见那边的注释）。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_week_label"
    android:initialLayout="@layout/widget_week_view"
    android:minHeight="40dp"
    android:minWidth="180dp"
    android:previewImage="@drawable/widget_week_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
