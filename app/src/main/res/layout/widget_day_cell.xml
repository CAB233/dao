<?xml version="1.0" encoding="utf-8"?>
<!--
  周列表里的一格。背景与文字颜色全部由 DaoWidgetProvider 逐格设置（RemoteViews 认不了主题色 token）。

  宽度：`0dp + layout_weight=1`，由所在的行等分（行在 ViewFlipper 里有确定宽度，weight 可靠）；
  四周的 `layout_margin` 是格子和格子之间的缝 —— 光把格子调窄没用（行是 LinearLayout 会紧挨着排）。

  高度：`match_parent`（父行有确定高度）。

  两行文字都是 `wrap_content`，靠父容器的 `gravity="center"` 整体居中。**不要给它们分 weight**：\n  月历格子只有 20dp 高，各分一半就是每行 10dp，12sp 的日期放不下会被裁一半，\n  看起来像"被下面的班次说明顶掉了"（真机反馈过）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_cell"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_margin="1dp"
    android:layout_weight="1"
    android:background="@drawable/widget_day_cell"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/day_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/day_shift"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="8sp" />
</LinearLayout>
