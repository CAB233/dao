<?xml version="1.0" encoding="utf-8"?>
<!-- 静态桌面预览：固定示例数字与嵌套权重仅用于添加小组件时展示。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText,NestedWeights"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background" android:orientation="vertical" android:padding="8dp">
    <TextView android:layout_width="match_parent" android:layout_height="16dp" android:gravity="center" android:text="@string/widget_preview_weekdays" android:textColor="@color/widget_summary" android:textSize="11sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/widget_preview_cell" android:gravity="center" android:text="28" android:textColor="@color/widget_on_surface" android:textSize="17sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/widget_preview_cell" android:gravity="center" android:text="29" android:textColor="@color/widget_on_surface" android:textSize="17sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/widget_preview_cell" android:gravity="center" android:text="30" android:textColor="@color/widget_on_surface" android:textSize="17sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/widget_preview_cell" android:gravity="center" android:text="1" android:textColor="@color/widget_on_surface" android:textSize="17sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/widget_preview_cell" android:gravity="center" android:text="2" android:textColor="@color/widget_on_surface" android:textSize="17sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/widget_preview_cell" android:gravity="center" android:text="3" android:textColor="@color/widget_on_surface" android:textSize="17sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:background="@drawable/widget_preview_cell" android:gravity="center" android:text="4" android:textColor="@color/widget_on_surface" android:textSize="17sp" />
    </LinearLayout>
</LinearLayout>
