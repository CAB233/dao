<?xml version="1.0" encoding="utf-8"?>
<!--
  「本周班次」小组件里的一项：一周 7 天，横排。
  由 DaoWeekStripService 逐项下发；列宽/高度由代码按 widget 宽度显式设置
  （嵌套 RemoteViews 里 layout_weight 不可靠，ListView 的 item 写 match_parent 也只会被当成 wrap_content）。

  这里的 56dp 是**兜底高度**：拿不到 widget 尺寸时仍能撑出"一行"，不会露出下一周的一条。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/week_strip"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:baselineAligned="false"
    android:orientation="horizontal" />
